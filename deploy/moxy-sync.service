# Moxy sync server — systemd unit for a plain VPS.
#
# Install:
#   sudo mkdir -p /opt/moxy && sudo cp -r server libs /opt/moxy/
#   sudo cp deploy/moxy-sync.service /etc/systemd/system/
#   sudo systemctl enable --now moxy-sync
#
# The database lands in /var/lib/moxy-sync/ (StateDirectory). Requires
# Node >= 24 at /usr/bin/node.
[Unit]
Description=Moxy zero-knowledge vault sync server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/moxy/server/moxy-sync-server.ts
WorkingDirectory=/opt/moxy
Restart=on-failure
RestartSec=2

# Runs behind a TLS reverse proxy (see Caddyfile); trust its client-IP header
# so rate limiting sees real addresses.
Environment=PORT=8787
Environment=MOXY_DB_PATH=/var/lib/moxy-sync/moxy-sync.db
Environment=MOXY_TRUST_PROXY=1

# Sandbox: ephemeral user, only the state directory is writable.
DynamicUser=yes
StateDirectory=moxy-sync
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
