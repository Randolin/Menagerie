# Moxy sync server — systemd unit for a plain VPS.
#
# Install:
#   sudo mkdir -p /opt/menagerie && sudo cp -r server libs /opt/menagerie/
#   sudo cp deploy/menagerie-sync.service /etc/systemd/system/
#   sudo systemctl enable --now menagerie-sync
#
# The database lands in /var/lib/menagerie-sync/ (StateDirectory). Requires
# Node >= 24 at /usr/bin/node.
[Unit]
Description=Menagerie zero-knowledge profile server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/menagerie/server/menagerie-sync-server.ts
WorkingDirectory=/opt/menagerie
Restart=on-failure
RestartSec=2

# Runs behind a TLS reverse proxy (see Caddyfile); trust its client-IP header
# so rate limiting sees real addresses.
Environment=PORT=8787
Environment=MENAGERIE_DB_PATH=/var/lib/menagerie-sync/menagerie-sync.db
Environment=MENAGERIE_TRUST_PROXY=1

# Sandbox: ephemeral user, only the state directory is writable.
DynamicUser=yes
StateDirectory=menagerie-sync
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
