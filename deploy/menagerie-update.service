# One update-and-cycle pass (see update.sh). Driven by menagerie-update.timer.
[Unit]
Description=Menagerie profile-server update
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# No repo-dir variable: update.sh locates the clone from its own path, so this
# unit keeps working if the clone ever moves or was installed under an older
# name. Point ExecStart at wherever the clone actually is.
ExecStart=/opt/menagerie/deploy/update.sh
